# Python food service (port 5000), separate from the authentication API.
# Use your computer's LAN IP on a phone, or 10.0.2.2 on Android Emulator.
# Leave unset in Expo LAN mode to use the Expo computer's host automatically.
# EXPO_PUBLIC_FOOD_API_URL=http://192.168.1.100:5000

# Account service (port 8000). Leave unset to use the Expo LAN host / web hostname.
# EXPO_PUBLIC_ACCOUNT_API_URL=http://192.168.1.100:8000
